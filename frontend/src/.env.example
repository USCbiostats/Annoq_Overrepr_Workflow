VITE_GA_MEASUREMENT_ID=G-FGZ5EP5C6R

# Base URL of the SNPWay backend API, without a trailing slash.
# Leave empty when the backend serves the built frontend (the default setup):
# requests then go to the same address the page was loaded from.
# Set it when running the frontend on its own with `npm run dev`, e.g.
#   VITE_BACKEND_BASE_URL=http://localhost:8002
# The value is built into the app, so rebuild after changing it.
VITE_BACKEND_BASE_URL=
