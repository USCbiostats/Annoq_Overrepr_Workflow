# SNPWay backend settings for the HRC AnnoQ API (GRCh37/hg19, dbSNP 151).
# Copy to .env and edit as necessary:  cp .env.hrc .env
# For TOPMed, copy .env.topmed instead. See README.md, "Configuration (.env)".

# AnnoQ api-v2 endpoints. A local api-v2: http://localhost:<SITE_PORT>/graphql
ANNOTATION_API_V2=https://api-v2.annoq.org/graphql
ANNOTATION_DOWNLOAD_V2=https://api-v2.annoq.org/download

# AnnoQ's rsID field for this dataset. It must match the API above:
# HRC calls it rs_dbSNP151 (TOPMed calls it rs_dbSNP).
ANNOQ_RSID_FIELD=rs_dbSNP151

# The AnnoQ site for this dataset. SNPWay shows the AnnoQ release version from
# its /version.json (e.g. 1.3.11) and links to it.
ANNOQ_SITE_URL=https://annoq.org

# Google Analytics for this deployment.
GA_MEASUREMENT_ID=G-FGZ5EP5C6R
GA_API_SECRET=api_secret

# Port for `python main.py` (API and frontend). Defaults to 8002 when unset.
# `uvicorn main:app --port <n>` ignores this and uses <n>.
PORT=8002
