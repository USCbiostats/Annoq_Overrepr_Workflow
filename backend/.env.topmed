# SNPWay backend settings for the TOPMed AnnoQ API (GRCh38/hg38, dbSNP 155).
# Copy to .env and edit as necessary:  cp .env.topmed .env
# For HRC, copy .env.hrc instead. See README.md, "Configuration (.env)".

# AnnoQ api-v2 endpoints. A local api-v2: http://localhost:<SITE_PORT>/graphql
ANNOTATION_API_V2=https://api-v2.topmed.annoq.org/graphql
ANNOTATION_DOWNLOAD_V2=https://api-v2.topmed.annoq.org/download

# AnnoQ's rsID field for this dataset. It must match the API above:
# TOPMed calls it rs_dbSNP (HRC calls it rs_dbSNP151).
ANNOQ_RSID_FIELD=rs_dbSNP

# The AnnoQ site for this dataset. SNPWay shows the AnnoQ release version from
# its /version.json and links to it. topmed.annoq.org does not publish
# /version.json yet, so SNPWay leaves the release version out until it does.
ANNOQ_SITE_URL=https://topmed.annoq.org

# Google Analytics for this deployment.
GA_MEASUREMENT_ID=G-FGZ5EP5C6R
GA_API_SECRET=api_secret

# Port for `python main.py` (API and frontend). Defaults to 8002 when unset;
# 8003 here so an HRC and a TOPMed SNPWay can run side by side.
# `uvicorn main:app --port <n>` ignores this and uses <n>.
PORT=8003
